# Server Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Session Configuration
# IMPORTANT: Generate a strong random secret for production
# Example: openssl rand -base64 32
SESSION_SECRET=your-super-secret-session-key-change-in-production

# Google OAuth Configuration
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Database Configuration
# Option 1: Use DATABASE_URL (recommended for production, e.g., Heroku, AWS RDS)
DATABASE_URL=postgresql://username:password@localhost:5432/ml_course_platform

# Option 2: Use individual connection parameters (alternative to DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ml_course_platform
DB_USER=username
DB_PASSWORD=password

# Database Connection Pool Configuration (optional - defaults provided)
DB_POOL_MAX=20              # Maximum number of clients in the pool (production default: 20)
DB_POOL_MIN=5               # Minimum number of clients in the pool (production default: 5)
DB_IDLE_TIMEOUT=30000       # Close idle clients after 30 seconds
DB_CONNECTION_TIMEOUT=2000  # Return error after 2 seconds if connection fails
DB_STATEMENT_TIMEOUT=30000  # Statement timeout in milliseconds
DB_QUERY_TIMEOUT=30000      # Query timeout in milliseconds

# Production-specific Configuration (set these in production)
# COOKIE_DOMAIN=.yourdomain.com  # Cookie domain for production (e.g., .example.com)
# TRUST_PROXY=1                  # Enable if behind a proxy (Heroku, AWS ELB, etc.)